---
import ButtonLink from "./ButtonLink.astro";
import DownloadMenu from "./DownloadMenu.astro";

const repo = "https://github.com/taskinoz/Impression-Eyes-Reborn";
const releases = `${repo}/releases`;
const latest = `${repo}/releases/latest/download`;
const downloads = [
  {
    href: `${latest}/ime-reborn-windows-x86_64-setup.exe`,
    name: "Installer",
    description: "Start menu entry and optional file associations",
    badge: "Recommended",
  },
  {
    href: `${latest}/ime-reborn-windows-x86_64.zip`,
    name: "Portable ZIP",
    description: "Extract anywhere — no installation",
  },
  {
    href: `${latest}/ime-reborn.exe`,
    name: "Standalone EXE",
    description: "Just the viewer executable",
  },
];
---

<section class="hero wrap">
  <div class="hero-copy">
    <p class="eyebrow">Open source · Windows · Rust</p>
    <h1>Images,<br><em>instantly.</em></h1>
    <p class="lede">
      A featherweight image viewer that opens fast, stays out of your way, and makes browsing a
      folder feel effortless.
    </p>
    <div class="actions">
      <DownloadMenu options={downloads} />
      <ButtonLink href={repo} label="View ime-reborn source code">View source</ButtonLink>
    </div>
    <p class="fine-print">
      Free forever. No accounts or telemetry. <a href={releases}>All releases</a>
    </p>
  </div>
  <div class="product-stage" role="img" aria-label="A preview of the borderless image viewer">
    <div class="glow"></div>
    <div class="viewer">
      <div class="image-scene">
        <span class="sun"></span><span class="ridge ridge-back"></span
        ><span class="ridge ridge-front"></span>
      </div>
      <span class="file-label">misty-morning.webp&nbsp; (100%)</span>
    </div>
  </div>
</section>
