---
import ButtonLink from "./ButtonLink.astro";

const support = "https://www.patreon.com/taskinoz";
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;
---

<section class="support wrap">
  <img src={asset("ime-reborn-logo.png")} alt="" width="72" height="72">
  <div>
    <p class="eyebrow">Pay nothing. Support if it earns it.</p>
    <h2>Useful software should stay accessible.</h2>
    <p>
      ime-reborn is free and open source. If it saves you time, an optional contribution helps fund
      signing, Store distribution and future releases.
    </p>
  </div>
  <ButtonLink href={support} label="Support ime-reborn on Patreon">Support on Patreon</ButtonLink>
</section>
